# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — AI blog ve konu üretimi (aistudio.google.com/apikey)
# gemini-2.0-flash kapatıldı; gemini-2.5-flash veya gemini-2.5-flash-lite kullanın
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Cron başına üretilecek yazı sayısı (ücretsiz kota: 1 önerilir)
GEMINI_POSTS_PER_CRON=1

# Pexels — ücretsiz stok görseller (https://www.pexels.com/api/)
# Opsiyonel; yoksa yedek görsel havuzu kullanılır
PEXELS_API_KEY=your-pexels-api-key

# Admin CMS giriş şifresi
ADMIN_PASSWORD=guclu-bir-sifre-buraya

# JWT imzalama (üretimde ADMIN_PASSWORD'dan farklı, min 32 karakter önerilir)
ADMIN_SECRET=uzun-rastgele-bir-secret-anahtar-buraya

# Vercel Cron güvenliği (Vercel otomatik ekler, manuel test için)
CRON_SECRET=vercel-cron-secret

# SMTP — iletişim formu ve bülten (mail.stradabilisim.com.tr)
SMTP_HOST=mail.stradabilisim.com.tr
SMTP_PORT=465
SMTP_USER=reports@stradabilisim.com.tr
SMTP_PASS=your-smtp-password
MAIL_FROM=reports@stradabilisim.com.tr
MAIL_TO=irfan@stradabilisim.com

# Demo provisioning — app public API (server-only, Vercel Production env)
# Upstream defaults to https://app.strada.tr when DEMO_PROVISION_API_URL is unset.
DEMO_PROVISION_API_URL=https://app.strada.tr
DEMO_PROVISION_API_KEY=shared-secret-with-entegre
# Login link in success UI (defaults to {API_URL}/login)
DEMO_APP_LOGIN_URL=https://app.strada.tr/login
